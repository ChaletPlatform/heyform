# Application
APP_HOMEPAGE_URL=http://localhost:9157

# Generate with: openssl rand -hex 32
SESSION_KEY=
FORM_ENCRYPTION_KEY=

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/heyform?appName=Cluster0

# SMTP — local dev: mailpit catches everything (web UI at http://localhost:8025)
# Production: swap host/port/user/password for real SMTP (Gmail app password, SES, etc.)
SMTP_FROM=HeyForm <noreply@yourdomain.com>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_IGNORE_CERT=true
