# Application
APP_HOMEPAGE_URL=http://localhost:9157

# Generate with: openssl rand -hex 32
SESSION_KEY=
FORM_ENCRYPTION_KEY=

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/heyform?appName=Cluster0

# SMTP
# Production: Google Workspace SMTP relay (no auth required, allowed by IP)
SMTP_FROM=HeyForm <noreply@getchalet.com>
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_IGNORE_CERT=false

# Local dev only: use mailpit instead
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_IGNORE_CERT=true
